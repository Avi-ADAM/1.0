            "role": "button",
            "name": "החל הכל"
          }
        },
        {
          "do": "click",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "פרסום לקהילה",
            "exact": true
          },
          "commits": true,
          "mark": "publish-carpentry"
        },
        {
          "do": "waitFor",
          "target": {
            "text": "/פורסם לקהילה/"
          },
          "timeout": 120000
        },
        {
          "do": "scroll",
          "target": {
            "css": ".plan-row",
            "hasText": "הרכבת מחשב שולחני"
          }
        },
        {
          "do": "click",
          "target": {
            "within": {
              "css": ".plan-row",
              "hasText": "הרכבת מחשב שולחני"
            },
            "role": "button",
            "name": "📣 פרסום לקהילה"
          },
          "mark": "publish-computer-open"
        },
        {
          "do": "waitFor",
          "target": {
            "role": "dialog"
          }
        },
        {
          "do": "click",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "✨ הצע עם AI"
          }
        },
        {
          "do": "waitFor",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "החל הכל"
          },
          "timeout": 300000,
          "note": "AI suggestion — sped up in the edit"
        },
        {
          "do": "highlight",
          "target": {
            "within": {
              "role": "dialog"
            },
            "text": "/שווי מוצע/"
          },
          "ms": 1800,
          "mark": "publish-computer-ai"
        },
        {
          "do": "click",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "החל הכל"
          }
        },
        {
          "do": "click",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "פרסום לקהילה",
            "exact": true
          },
          "commits": true,
          "mark": "publish-computer"
        },
        {
          "do": "waitFor",
          "target": {
            "text": "/פורסם לקהילה/"
          },
          "timeout": 120000
        }
      ],
      "timeout": 60000
    },
    {
      "id": "s04-supplier-applies",
      "title": "ספקית רואה את הצורך ומציעה את עצמה",
      "chapter": "3 · הצעות",
      "session": "sup2",
      "narration": "בעלת מקצוע שמתאימה לחלק מהמשאלה מקבלת כרטיס בלב שלה ומייל. היא יכולה להציע את עצמה כמו שזה, או להציע תנאים אחרים — שעות ומחיר — והלקוחה תענה.",
      "setup": [
        {
          "do": "goto",
          "url": "/lev"
        },
        {
          "do": "waitFor",
          "target": {
            "role": "button",
            "name": "/^הצעת משימה · בניית שולחן עץ/"
