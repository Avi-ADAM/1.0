            "name": "/^הצעת משימה · בניית שולחן עץ/"
          },
          "ms": 1800,
          "mark": "apply-table-coin"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "/^הצעת משימה · בניית שולחן עץ/"
