            "role": "dialog"
          }
        },
        {
          "do": "click",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "✨ הצע עם AI"
          }
        },
        {
          "do": "waitFor",
          "target": {
            "within": {
              "role": "dialog"
            },
            "role": "button",
            "name": "החל הכל"
          },
          "timeout": 300000,
          "note": "AI suggestion — sped up in the edit"
        },
        {
          "do": "highlight",
          "target": {
            "within": {
              "role": "dialog"
            },
            "text": "/שווי מוצע/"
          },
          "ms": 1800,
