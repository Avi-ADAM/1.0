    {
      "id": "s07-consent",
      "title": "סוגרים הסכמה — ונוצרת רקמה",
      "chapter": "4 · הסכמה",
      "session": "customer",
      "narration": "כשכל החלקים מאושרים, סוגרים את ההסכמה. ברגע הזה נוצרת רקמה — שותפות של כל מי שעובד על המשאלה שלכם — והעסקה עוברת לביצוע.",
      "setup": [
        {
          "do": "goto",
          "url": "/concierge/${wishId}"
        },
        {
          "do": "waitFor",
