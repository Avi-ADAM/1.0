# Socket.IO Server Configuration
PORT=3001

# Allowed client origins (comma-separated)
# Development: http://localhost:5173
# Production: https://www.1lev1.com,https://1lev1.com,https://meetings.1lev1.com
CLIENT_URL=http://localhost:5173,https://www.1lev1.com,https://1lev1.com,https://meetings.1lev1.com

# Environment
NODE_ENV=development

# JWT Secret for token verification (REQUIRED)
# This is the JWT_SECRET from Strapi's .env file
# Get it from your Strapi backend configuration
JWT_SECRET=your-strapi-jwt-secret-here

# Guest invitation signing secret (REQUIRED for meeting guests)
# Must be the SAME value as in the main app (1.0main) and the meetings app
# (magik-meetings). Guests have no JWT: their signed invitation link is what
# lets them subscribe to their meeting's notifications. Unset, guest
# sockets are simply refused - no guest realtime, nothing else affected.
GUEST_INVITE_SECRET=

# SSL Configuration (for production subdomain deployment)
# Uncomment and set paths when deploying to so.1lev1.com
# SSL_CERT=/etc/letsencrypt/live/so.1lev1.com/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/so.1lev1.com/privkey.pem
