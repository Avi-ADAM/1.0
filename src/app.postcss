.btnb {
  height: 44px;
  width: 60px;
  position: absolute;
  top: calc(90% - 48px);
  right: calc(90% - 64px);
  border: 1px solid red;
  border-radius: 25%;
  padding: 9px 16px;
}
.btnc {
  height: 44px;
  width: 58px;
  position: absolute;
  top: calc(90% - 48px);
  right: calc(50% - 29px);
  border: 1px solid red;
  border-radius: 25%;
  padding: 9px 16px;
}
.btna {
  height: 44px;
  width: 60px;
  position: absolute;
  top: calc(90% - 48px);
  left: calc(90% - 64px);
  border: 1px solid var(--barbi-pink);
  border-radius: 25%;
  padding: 9px 16px;
}
.sg-task-content {
  font-size: 24px !important;
}

.sg-task {
  color: var(--barbi-pink);
}
.sg-task.blue {
  background: rgb(116, 191, 255);
  color: var(--barbi-pink);
}

.sg-task.blue:hover {
  background: rgb(98, 161, 216);
}

.sg-task.blue.selected {
  background: rgb(69, 112, 150);
}

.sg-task.selected:hover {
  background: rgb(60, 98, 131);
}

.sg-task.green {
  background-color: rgb(242, 229, 242);
  color: var(--barbi-pink);
}

.sg-task.green:hover {
  background-color: var(--barbi-pink);
  color: var(--gold);
}

.sg-task.green.selected {
  background: rgb(121, 150, 125);
}

.sg-task.green.selected:hover {
  background: rgb(100, 126, 103);
}

.sg-task.pink {
  background-color: var(--mpink);
  color: var(--gold);
  text-shadow: 1px 1px var(--barbi-pink);
}

.sg-task.pink:hover {
  background-color: var(--barbi-pink);
  color: var(--gold);
}

.sg-task.pink.selected {
  background: rgb(121, 150, 125);
}

.sg-task.pink.selected:hover {
  background: rgb(100, 126, 103);
}

.sg-task.orange {
  background-color: rgb(254, 172, 49);
  color: black;
}

.sg-task.orange:hover {
  background-color: rgb(238, 161, 45);
}

.sg-task.orange.selected {
  background-color: rgb(219, 149, 45);
}

.sg-task.orange.selected:hover {
  background-color: rgb(199, 135, 38);
}

.coinmodal {
  z-index: 999 !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  height: 100%;
  width: 100vw;
  display: grid;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  transform: none !important;
  overflow: hidden;
}
.coinmodal::before,
.coinmodal::after {
  background: rgba(0, 0, 0, 0.5);
}
.top {
  position: fixed;
  top: 0%;
  left: 50%;
}

:root {
  --range-slider: hsl(54.7, 66.7%, 80%);
  --range-handle-inactive: hsl(180, 4.6%, 61.8%);
  --range-handle: hsl(234, 67.6%, 71%);
  --range-handle-focus: hsl(325.6, 100%, 50%);
  --range-handle-border: hsl(234, 67.6%, 71%);
  --range-range-inactive: hsl(54.7, 66.7%, 80%);
  --range-range: hsl(325.6, 100%, 50%);
  --range-float-inactive: hsl(180, 4.6%, 61.8%);
  --range-float: hsl(324.2, 100%, 48%);
  --range-float-text: hsl(0, 0%, 100%);

  --range-pip: hsl(210, 14.3%, 53.3%);
  --range-pip-text: hsl(210, 14.3%, 53.3%);
  --range-pip-active: hsl(180, 25.4%, 24.7%);
  --range-pip-active-text: hsl(180, 25.4%, 24.7%);
  --range-pip-hover: hsl(180, 25.4%, 24.7%);
  --range-pip-hover-text: hsl(180, 25.4%, 24.7%);
  --range-pip-in-range: hsl(180, 25.4%, 24.7%);
  --range-pip-in-range-text: hsl(180, 25.4%, 24.7%);
}
@import url('https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Cinzel:wght@400;600&display=swap');

:root {
  --bg: #070606;
  --s1: #0e0d0c;
  --s2: #171512;
  --s3: #201d19;
  --s4: #2a2520;
  --gold: #eee8aa;
  --gold-l: #f0c040;
  --gold-ll: #fde68a;
  --gold-d: rgba(200, 150, 12, 0.18);
  --gold-dd: rgba(200, 150, 12, 0.07);
  --pink: #c8155f;
  --pink-l: #ff4d9e;
  --pink-d: rgba(200, 21, 95, 0.14);
  --text: #ede5d8;
  --tm: #9a8f80;
  --td: #52493e;
  --border: rgba(255, 255, 255, 0.05);
  --border-g: rgba(200, 150, 12, 0.22);
  --success: #4ade80;
  --r: 14px;
  --rl: 22px;
}

*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Heebo', sans-serif;
  direction: rtl;
  min-height: 100vh;
  overflow-x: hidden;
  /* Room for the fixed footer bar, so a scrolling page's last row is never
     left under it. `mobileFooter` owns --foot-pad: it matches the bar's
     current mode, drops to 0 on a page that fits the viewport exactly, and is
     removed entirely on the routes that hide the bar (the wish composer,
     onboarding). See the FOOT_PAD effect there for why.

     Pages have been hand-rolling this for years (`pb-24`, `padding-bottom:
     80px`, `pb-16`…) and the ones that forgot it render their footer-most row
     under the bar. Those keep working: an extra tail below the last element is
     harmless, a missing one is not. */
  padding-bottom: var(--foot-pad, 0px);
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(
      ellipse 70% 50% at 15% 0%,
      rgba(200, 150, 12, 0.07) 0%,
      transparent 55%
    ),
    radial-gradient(
      ellipse 55% 60% at 85% 90%,
      rgba(200, 21, 95, 0.06) 0%,
      transparent 55%
    );
  pointer-events: none;
  z-index: 0;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim {
  animation: fadeUp 0.35s ease both;
}
.anim-d1 {
  animation-delay: 0.05s;
}
.anim-d2 {
  animation-delay: 0.1s;
}
.anim-d3 {
  animation-delay: 0.15s;
}
.anim-d4 {
  animation-delay: 0.2s;
}
.anim-d5 {
  animation-delay: 0.25s;
}

.page-wrap {
  position: relative;
  z-index: 1;
  padding: 32px;
  max-width: 1400px;
  margin: 0 auto;
}

/* Shared page header shell — used by /deals and its children (e.g. sales-center)
   so a title block always reads as one page under the same AppHeader. */
.page-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 16px;
}
.page-title {
  font-size: 28px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 4px;
}
.page-top .accent {
  color: var(--gold-l);
}
.page-logo {
  width: 90px;
  height: 90px;
  object-fit: contain;
  flex-shrink: 0;
}
.page-sub {
  font-size: 13px;
  color: var(--tm);
}
@media (max-width: 600px) {
  .page-top {
    flex-direction: column;
    align-items: flex-start;
  }
}

.section-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--tm);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(to left, transparent, var(--border));
}

.btn-primary {
  background: linear-gradient(135deg, var(--pink), var(--pink-l));
  border: none;
  color: #fff;
  font-family: 'Heebo', sans-serif;
  font-size: 13px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: 10px;
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(200, 21, 95, 0.35);
  transition: all 0.2s;
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 26px rgba(200, 21, 95, 0.5);
}

.prog-bar {
  height: 4px;
  background: var(--s3);
  border-radius: 99px;
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--gold), var(--gold-l));
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}
.prog-fill.pink {
  background: linear-gradient(90deg, var(--pink), var(--pink-l));
}
.prog-fill.green {
  background: linear-gradient(90deg, #16a34a, #4ade80);
}

@media (max-width: 900px) {
  .page-wrap {
    padding: 20px;
  }
}
@media (max-width: 600px) {
  .page-wrap {
    padding: 16px;
  }
}

/* ==========================================================================
   APPEARANCE LAYER — theme (personal | business) × mode (light | dark)
   --------------------------------------------------------------------------
   Deliberately the LAST block in this file, and written with `html.x`
   selectors (specificity 0,1,1) rather than `:root` (0,1,0).
   Both matter: the `:root` block further up redefines `--gold` *after* the
   old `.business` rules, so a plain class block loses to it on source order
   and the business palette never applied even when the class was present.

   THE GOLD / BARBI CONTRACT
   The two dominant tokens are a *pair*, not two independent colours:
     --gold       the LIGHT side. Pale card wash (`bg-gold`) and the ink laid
                  on top of the brand (`bg-barbi text-gold`, 103 call sites).
                  It stays light in every theme and every mode — that is what
                  keeps `bg-barbi text-gold` and `bg-gold text-barbi` legible
                  without touching a single component.
     --barbi-pink the SATURATED brand side. Dark enough that --gold reads on
                  top of it, light enough to read as ink on a pale card.
   The gold gradient ramp (--gra…--gre) is the light side too: components pair
   `from-gra … text-barbi` with `hover:from-barbi … hover:text-gold`, i.e. the
   ramp and the brand swap roles on hover. So the ramp must stay pale.

     --goldink    NEW. --gold cannot double as ink on a white surface (at
                  #eee8aa on white that is ~1.2:1 — invisible, an existing bug
                  on 59 `bg-white border-gold text-gold` outline buttons).
                  --goldink is the readable counterpart for exactly that role,
                  and it flips with the mode: dark ink on light, light on dark.

   Every value below is checked against its intended background for WCAG AA
   (>=4.5:1 for text). The ratio is noted where it is not obvious.
   ========================================================================== */

/* --- shared scalars ------------------------------------------------------ */
html.personal {
  --radius-theme: 0.75rem;
  --shadow-theme: 0 10px 15px -3px rgb(0 0 0 / 0.1);
}
html.business {
  /* Sharper corners and a tighter shadow are most of what reads as
     "professional" before a single colour changes. */
  --radius-theme: 0.25rem;
  --shadow-theme:
    0 1px 2px rgb(15 23 42 / 0.08), 0 1px 3px rgb(15 23 42 / 0.06);
  --radius: 0.25rem;
}

/* --- PERSONAL · LIGHT ---------------------------------------------------- */
/* Pins today's look so a stray `:root` further up cannot drift it. Only
   --goldink is genuinely new here; it fixes the invisible outline buttons. */
html.personal {
  --gold: #eee8aa;
  --goldink: #8a6a15; /* 5.1:1 on white */
  /* Was #ff0092, the only value in this block with no ratio noted - because it
     did not meet the contract stated above. --gold on it measured 2.96:1 and
     it measured 3.71:1 as ink on white, against the 4.5:1 this file requires;
     axe-core flagged 17 nodes across five pages, all of them the primary CTA
     (`bg-barbi text-gold`, 131 call sites) and the pink-on-white hover it
     swaps to. No brand-appropriate ink passes on #ff0092 - even white reaches
     only 3.71:1 - so the saturated side is what had to move. Same hue family,
     one step deeper, and now it satisfies the pair contract in both roles. */
  --barbi-pink: #b80069; /* 6.5:1 on white · --gold on it = 5.2:1 */
  --pinki: rgb(242, 229, 242);
  --blue: rgb(182, 240, 255);
  --naim: rgba(251, 207, 232);
  --lturk: rgb(103, 232, 249);
  --mturk: rgb(34, 211, 238);
  --sturk: #ccfbf1;
  --lpink: rgb(251, 207, 232);
  --mpink: rgb(244, 114, 182);
}

/* --- PERSONAL · DARK ----------------------------------------------------- */
/* Intentionally minimal. 1.4k hand-authored `dark:` utilities already carry
   this theme's night look, and they were written against LIGHT --gold /
   --barbi (e.g. `bg-gold text-gray-600`, `dark:bg-gray-800 text-gold`).
   Inverting the pair here would break those pairings, so only --goldink —
   which has no legacy call sites — flips. */
html.personal.dark {
  --goldink: #f0c040; /* 8.6:1 on slate-800 */
}

/* --- BUSINESS · LIGHT ---------------------------------------------------- */
html.business {
  /* the pair */
  --gold: #f8fafc;
  --goldink: #1e3a8a; /* 10.2:1 on white */
  --barbi-pink: #1d4ed8; /* 6.6:1 on white · --gold on it = 6.4:1 */

  /* surfaces */
  --pinki: #f1f5f9;
  --blue: #e0f2fe;
  --naim: #f1f5f9;
  --sturk: #f1f5f9;
  --lpink: #e2e8f0;
  --silver: #cbd5e1;
  --background-without-opacity: rgb(255 255 255 / 0.92);
  --column-width: 42rem;
  --column-margin-top: 4rem;

  /* ink & accents — all >=4.5:1 on white */
  --lturk: #0369a1; /* 6.0:1 */
  --mturk: #0f766e; /* 5.6:1 */
  --mpink: #334155; /* 10.4:1 */
  --blu: #1e3a8a;
  --stgold: #334155;
  --neww: #0e7490;
  --wow: #047857;
  --wow2: #15803d;
  --wowt: #064e3b;
  --blueg: #2563eb;
  --oranges: #b45309;

  /* the gradient ramp — brushed steel, kept pale so `text-barbi` on it is
     5.1:1 at the ramp's darkest stop */
  --gra: #e8edf3;
  --grb: #f8fafc;
  --grc: #dde3ea;
  --grd: #f1f5f9;
  --gre: #e8edf3;
  /* see --ramp-ink in :root — dark in both modes, because the steel ramp is
     pale in both modes. 15.6:1 on #e8edf3. */
  --ramp-ink: #0f172a;
  --graa: #e8edf3;
  --grbb: #1e293b;

  /* the /deals design-system scalars — --bg and --text flip together, so any
     component pairing them stays consistent */
  --bg: #eef2f7;
  --s1: #ffffff;
  --s2: #f8fafc;
  --s3: #f1f5f9;
  --s4: #e2e8f0;
  --text: #0f172a; /* 17.4:1 on white */
  --tm: #475569; /* 7.4:1 on white */
  --td: #94a3b8;
  --border: rgb(15 23 42 / 0.12);
  --border-g: rgb(29 78 216 / 0.28);
  --pink: #1d4ed8;
  --pink-l: #3b82f6;
  --gold-l: #1e40af;
  --gold-ll: #dbeafe;
  --gold-d: rgb(29 78 216 / 0.12);
  --gold-dd: rgb(29 78 216 / 0.05);
  --success: #047857;

  /* shadcn tokens */
  --background: #f8fafc;
  --foreground: #0f172a;
  --card: #ffffff;
  --card-foreground: #0f172a;
  --popover: #ffffff;
  --popover-foreground: #0f172a;
  --primary: #1d4ed8;
  --primary-foreground: #f8fafc;
  --secondary: #e2e8f0;
  --secondary-foreground: #0f172a;
  --muted: #f1f5f9;
  --muted-foreground: #475569;
  --accent: #e0e7ff;
  --accent-foreground: #1e3a8a;
  --destructive: #b91c1c; /* 6.2:1 on white */
  --input: #cbd5e1;
  --ring: #1d4ed8;
  --sidebar: #f1f5f9;
  --sidebar-foreground: #0f172a;
  --sidebar-primary: #1d4ed8;
  --sidebar-primary-foreground: #f8fafc;
  --sidebar-accent: #e2e8f0;
  --sidebar-accent-foreground: #0f172a;
  --sidebar-border: rgb(15 23 42 / 0.12);
  --sidebar-ring: #1d4ed8;
}

/* --- BUSINESS · DARK ----------------------------------------------------- */
html.business.dark {
  /* --gold stays on the light side (see the contract above); it is only
     dimmed so it does not glare. --barbi-pink is the compromise token: at
     #2563eb it holds 4.8:1 against --gold for `bg-barbi text-gold`, and the
     same 4.8:1 as ink on the pale cards where `text-barbi` overwhelmingly
     sits. Bare `text-barbi` directly on the page background is the weak
     case; components that put text there use `dark:text-*` utilities. */
  --gold: #f1f5fb;
  --goldink: #93c5fd; /* 8.1:1 on slate-800 */
  --barbi-pink: #2563eb;

  --pinki: #16223a;
  --blue: #16334d;
  --naim: #16223a;
  --sturk: #16223a;
  --lpink: #1f2f4d;
  --silver: #475569;

  --lturk: #7dd3fc;
  --mturk: #5eead4;
  --mpink: #cbd5e1;
  --blu: #93c5fd;
  --stgold: #cbd5e1;
  --neww: #67e8f9;
  --wow: #34d399;
  --wow2: #a3e635;
  --wowt: #d1fae5;
  --blueg: #93c5fd;
  --oranges: #fbbf24;

  --background-without-opacity: rgb(17 27 46 / 0.92);

  --bg: #0b1220;
  --s1: #111b2e;
  --s2: #172440;
  --s3: #1f2f4d;
  --s4: #2a3c5e;
  --text: #e8eef7;
  --tm: #a3b3c9;
  --td: #64748b;
  --border: rgb(255 255 255 / 0.12);
  --border-g: rgb(96 165 250 / 0.30);
  --pink: #2563eb;
  --pink-l: #60a5fa;
  --gold-l: #93c5fd;
  --gold-ll: #dbeafe;
  --gold-d: rgb(96 165 250 / 0.16);
  --gold-dd: rgb(96 165 250 / 0.07);
  --success: #34d399;

  --background: #0b1220;
  --foreground: #e8eef7;
  --card: #111b2e;
  --card-foreground: #e8eef7;
  --popover: #172440;
  --popover-foreground: #e8eef7;
  --primary: #60a5fa;
  --primary-foreground: #0b1220;
  --secondary: #1f2f4d;
  --secondary-foreground: #e8eef7;
  --muted: #172440;
  --muted-foreground: #a3b3c9;
  --accent: #1e3a8a;
  --accent-foreground: #dbeafe;
  --destructive: #f87171;
  --input: #2a3c5e;
  --ring: #60a5fa;
  --sidebar: #111b2e;
  --sidebar-foreground: #e8eef7;
  --sidebar-primary: #60a5fa;
  --sidebar-primary-foreground: #0b1220;
  --sidebar-accent: #1f2f4d;
  --sidebar-accent-foreground: #e8eef7;
  --sidebar-border: rgb(255 255 255 / 0.12);
  --sidebar-ring: #60a5fa;
}


/* --- identity colour families -------------------------------------------
   Consumed by the `pink`/`amber`/… entries in tailwind.config.cjs. These are
   the stock Tailwind values, declared on :root so an unclassed <html> still
   paints; `html.business` further down swaps them. Channels are
   space-separated R G B because the config wraps them in rgb(… / <alpha>).
   ------------------------------------------------------------------------ */
:root {
  --c-pink-50: 253 242 248;
  --c-pink-100: 252 231 243;
  --c-pink-200: 251 207 232;
  --c-pink-300: 249 168 212;
  --c-pink-400: 244 114 182;
  --c-pink-500: 236 72 153;
  --c-pink-600: 219 39 119;
  --c-pink-700: 190 24 93;
  --c-pink-800: 157 23 77;
  --c-pink-900: 131 24 67;
  --c-pink-950: 80 7 36;

  --c-fuchsia-50: 253 244 255;
  --c-fuchsia-100: 250 232 255;
  --c-fuchsia-200: 245 208 254;
  --c-fuchsia-300: 240 171 252;
  --c-fuchsia-400: 232 121 249;
  --c-fuchsia-500: 217 70 239;
  --c-fuchsia-600: 192 38 211;
  --c-fuchsia-700: 162 28 175;
  --c-fuchsia-800: 134 25 143;
  --c-fuchsia-900: 112 26 117;
  --c-fuchsia-950: 74 4 78;

  --c-rose-50: 255 241 242;
  --c-rose-100: 255 228 230;
  --c-rose-200: 254 205 211;
  --c-rose-300: 253 164 175;
  --c-rose-400: 251 113 133;
  --c-rose-500: 244 63 94;
  --c-rose-600: 225 29 72;
  --c-rose-700: 190 18 60;
  --c-rose-800: 159 18 57;
  --c-rose-900: 136 19 55;
  --c-rose-950: 76 5 25;

  --c-purple-50: 250 245 255;
  --c-purple-100: 243 232 255;
  --c-purple-200: 233 213 255;
  --c-purple-300: 216 180 254;
  --c-purple-400: 192 132 252;
  --c-purple-500: 168 85 247;
  --c-purple-600: 147 51 234;
  --c-purple-700: 126 34 206;
  --c-purple-800: 107 33 168;
  --c-purple-900: 88 28 135;
  --c-purple-950: 59 7 100;

  --c-violet-50: 245 243 255;
  --c-violet-100: 237 233 254;
  --c-violet-200: 221 214 254;
  --c-violet-300: 196 181 253;
  --c-violet-400: 167 139 250;
  --c-violet-500: 139 92 246;
  --c-violet-600: 124 58 237;
  --c-violet-700: 109 40 217;
  --c-violet-800: 91 33 182;
  --c-violet-900: 76 29 149;
  --c-violet-950: 46 16 101;

  --c-amber-50: 255 251 235;
  --c-amber-100: 254 243 199;
  --c-amber-200: 253 230 138;
  --c-amber-300: 252 211 77;
  --c-amber-400: 251 191 36;
  --c-amber-500: 245 158 11;
  --c-amber-600: 217 119 6;
  --c-amber-700: 180 83 9;
  --c-amber-800: 146 64 14;
  --c-amber-900: 120 53 15;
  --c-amber-950: 69 26 3;

  --c-yellow-50: 254 252 232;
  --c-yellow-100: 254 249 195;
  --c-yellow-200: 254 240 138;
  --c-yellow-300: 253 224 71;
  --c-yellow-400: 250 204 21;
  --c-yellow-500: 234 179 8;
  --c-yellow-600: 202 138 4;
  --c-yellow-700: 161 98 7;
  --c-yellow-800: 133 77 14;
  --c-yellow-900: 113 63 18;
  --c-yellow-950: 66 32 6;
}

/* Business overrides for the identity families. Each ramp keeps its LIGHTNESS
   structure, so existing `bg-x-100 text-x-700` pairings keep their contrast
   relationship — the light end turns neutral (less colour noise) while the
   strong end keeps a deliberate accent (more contrast).
     pink/fuchsia/rose  light -> slate surfaces, strong -> brand blue
     purple/violet      fully neutral; they were decoration only
     amber/yellow       neutral backgrounds, but the ink stays amber so
                        "needs attention" still reads as such, just darker.
   One ramp serves both light and dark: components already pick the right
   shade per mode via their own `dark:` variants, so inverting here would
   fight them. */
html.business {
  --c-pink-50: 248 250 252;
  --c-pink-100: 241 245 249;
  --c-pink-200: 226 232 240;
  --c-pink-300: 191 219 254;
  --c-pink-400: 96 165 250;
