  --c-fuchsia-700: 30 64 175;
  --c-fuchsia-800: 30 58 138;
  --c-fuchsia-900: 23 37 84;
  --c-fuchsia-950: 15 23 42;

  --c-rose-50: 248 250 252;
  --c-rose-100: 241 245 249;
  --c-rose-200: 226 232 240;
  --c-rose-300: 191 219 254;
  --c-rose-400: 96 165 250;
  --c-rose-500: 37 99 235;
  --c-rose-600: 29 78 216;
