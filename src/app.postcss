@media (max-width: 500px) {
  .d::-webkit-scrollbar {
    width: 5px;
  }
}
@media (min-width: 501px) {
  .d::-webkit-scrollbar {
    width: 10px;
  }
}
:root {
  --radius: 0.625rem;
  --background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary: oklch(0.205 0 0);
  --primary-foreground: oklch(0.985 0 0);
  --secondary: oklch(0.97 0 0);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --accent: oklch(0.97 0 0);
  --accent-foreground: oklch(0.205 0 0);
  --destructive: oklch(0.577 0.245 27.325);
  --border: oklch(0.922 0 0);
  --input: oklch(0.922 0 0);
  --ring: oklch(0.708 0 0);
  --chart-1: oklch(0.646 0.222 41.116);
  --chart-2: oklch(0.6 0.118 184.704);
  --chart-3: oklch(0.398 0.07 227.392);
  --chart-4: oklch(0.828 0.189 84.429);
  --chart-5: oklch(0.769 0.188 70.08);
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: oklch(0.205 0 0);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.97 0 0);
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.922 0 0);
  --sidebar-ring: oklch(0.708 0 0);
}

.dark {
  --background: oklch(0.145 0 0);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --popover: oklch(0.269 0 0);
  --popover-foreground: oklch(0.985 0 0);
  --primary: oklch(0.922 0 0);
  --primary-foreground: oklch(0.205 0 0);
  --secondary: oklch(0.269 0 0);
  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.269 0 0);
  --muted-foreground: oklch(0.708 0 0);
  --accent: oklch(0.371 0 0);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.488 0.243 264.376);
  --chart-2: oklch(0.696 0.17 162.48);
  --chart-3: oklch(0.769 0.188 70.08);
  --chart-4: oklch(0.627 0.265 303.9);
  --chart-5: oklch(0.645 0.246 16.439);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.439 0 0);
}
:global(.dark) {
  --sdt-bg-main: var(--background);
  --sdt-shadow-color: #777;
  --sdt-color: #eee;
  --sdt-clock-color: var(--sdt-color);
  --sdt-clock-color-hover: var(--sdt-color);
  --sdt-clock-time-bg: transparent;
  --sdt-clock-time-bg-hover: transparent;
  --sdt-clock-disabled: #b22222;
  --sdt-clock-disabled-bg: var(--sdt-bg-main);
  --sdt-clock-selected-bg: var(--sdt-bg-selected);
  --sdt-header-color: #eee;
  --sdt-bg-selected: #e1ac4a;
  --sdt-table-disabled-date: #b22222;
  --sdt-table-disabled-date-bg: var(--sdt-bg-main);
  --sdt-table-data-bg-hover: #777;
  --sdt-table-selected-bg: var(--sdt-bg-selected);
  --sdt-header-btn-bg-hover: #777;
  --sdt-color-selected: #fff;
  --sdt-table-today-indicator: #ccc;
  --sdt-clock-bg: #999;
  /* custom buttons */
  --sdt-today-bg: #e4a124;
  --sdt-today-color: #fff;
  --sdt-clear-color: #666;
  --sdt-clear-bg: #ddd;
  --sdt-clear-hover-color: #fff;
  --sdt-clear-hover-bg: #dc3545;
}
:global(.light) {
  --sdt-bg-main: #fff;
  --sdt-shadow-color: #ccc;
  --sdt-color: inherit;
  --sdt-clock-color: var(--sdt-color);
  --sdt-clock-color-hover: var(--sdt-color);
  --sdt-clock-time-bg: transparent;
  --sdt-clock-time-bg-hover: transparent;
  --sdt-clock-disabled: #b22222;
  --sdt-clock-disabled-bg: var(--sdt-bg-main);
  --sdt-clock-selected-bg: var(--sdt-bg-selected);
  --sdt-bg-selected: #286090;
  --sdt-table-disabled-date: #b22222;
  --sdt-table-disabled-date-bg: var(--sdt-bg-main);
  --sdt-table-data-bg-hover: #eee;
  --sdt-table-selected-bg: var(--sdt-bg-selected);
  --sdt-header-btn-bg-hover: #dfdfdf;
  --sdt-color-selected: #fff;
  --sdt-table-today-indicator: #ccc;
  --sdt-clock-bg: #eeeded;
  /* custom buttons */
  --sdt-today-bg: #1e486d;
  --sdt-today-color: #fff;
  --sdt-clear-color: #dc3545;
  --sdt-clear-bg: #fff;
  --sdt-clear-hover-color: #fff;
  --sdt-clear-hover-bg: #dc3545;
}
.tooltip {
  z-index: 9999 !important;
  color: black;
}
.d::-webkit-scrollbar-track {
  background-color: #e4e4e4;
  border-radius: 100px;
}
@keyframes textPathMove {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
.animate-spin-slow {
  animation: textPathMove 40s linear infinite;
  transform-origin: center;
}

/* האנימציה משנה את ה-startOffset כדי לסובב את הטקסט */
@keyframes rotateText {
  from {
    startoffset: 25%;
  }
  to {
    startoffset: 125%;
  }
}

.animate-text-move {
  animation: textPathMove 40s linear infinite;
  transform-origin: center;
}
.d::-webkit-scrollbar-thumb {
  background-color: #d4aa70;
  border-radius: 100px;
}
.d::-webkit-scrollbar-thumb {
  background-image: linear-gradient(180deg, #d0368a 0%, #708ad4 99%);
  box-shadow: inset 2px 2px 5px 0 whitegold;
  border-radius: 100px;
}

textarea::-webkit-resizer {
  border-width: 8px;
  border-style: solid;
  border-color: transparent transparent var(--gold) var(--gold);
}

.textinput {
  position: relative;
  width: 100%;
  display: block;
}

.input {
  border: none;
  margin: 0;
  padding: 10px 0;
  outline: none;
  border-bottom: solid 1px var(--gold);
  font-size: 15px;
  margin-top: 12px;
  width: 100%;
  color: var(--gold);
  -webkit-tap-highlight-color: transparent;
  background: transparent;
}
.label {
  font-size: 15px;
  position: absolute;
  top: 22px;
  transition: 0.2s cubic-bezier(0, 0, 0.3, 1);
  pointer-events: none;
  color: var(--gold);
  user-select: none;
}

.line {
  height: 2px;
  background-color: #2196f3;
  position: absolute;
  transform: translateX(-50%);
  left: 50%;
  bottom: 0;
  width: 0;
  transition: 0.2s cubic-bezier(0, 0, 0.3, 1);
}

.input:focus ~ .line,
.input:valid ~ .line {
  width: 100%;
}

.input:focus ~ .label,
.input:valid ~ .label {
  font-size: 14px;
  color: turquoise;
  top: 0;
}
.input:focus,
.input:valid {
  border: 0;
}

@media (max-width: 600px) {
  .textinput {
    position: relative;
    width: 100%;
    display: block;
  }
}
.modal-bar {
  border-bottom-left-radius: 0.5rem;
  border-bottom-right-radius: 0.5rem;
}
.modal-button:hover {
  background-color: #2f855a !important;
  color: #fff !important;
}
.modal-time {
  background-color: #2f855a;
  border-top-left-radius: 0.5rem;
  border-top-right-radius: 0.5rem;
  font-weight: 300;
}
.info {
  z-index: 99999;
}

:root {
  font-family:
    'Bellefair',
    'RubikMicrobe',
    Arial,
    -apple-system,
    BlinkMacSystemFont,
    'Segoe UI',
    Roboto,
    Oxygen,
    Ubuntu,
    Cantarell,
    'Open Sans',
    'Helvetica Neue',
    sans-serif;
  --bal: 'Bellefair', 'RubikMicrobe';
  --font-mono: 'Fira Mono', monospace;
  --pure-white: #ffffff;
  --primary-color: #b9c6d2;
  --secondary-color: #d0dde9;
  --tertiary-color: #cfcf93;
  --accent-color: #ff3e00;
  --heading-color: rgba(0, 0, 0, 0.7);
  --text-color: #444444;
  --gold: #eee8aa;
  /* Fallback only — the real per-theme value lives in the appearance layer at
     the end of this file. Kept here so an unclassed <html> still renders. */
  --goldink: #8a6a15;
  --barbi-pink: #ff0092;
  --pinki: rgb(242, 229, 242);

  --blue: rgb(182, 240, 255);
  --background-without-opacity: rgba(255, 255, 255, 0.7);
  --column-width: 42rem;
  --column-margin-top: 4rem;
  --naim: rgba(251, 207, 232);
  --lturk: rgb(103, 232, 249);
  --mturk: rgb(34, 211, 238);
  --sturk: #ccfbf1;
  --lpink: rgb(251, 207, 232);
  --mpink: rgb(244, 114, 182);
  --blu: #04619f;
  --silver: #bbc2cc;
  --stgold: #574010;
  --gra: #bf953f;
  --grb: #fcf6ba;
  --grc: #b38728;
  --grd: #fbf5b7;
  --gre: #aa771c;
  /* Ink for text laid directly on the gold/steel ramp above (and on the
     `bg-white/xx` cards floating on it). The ramp is the LIGHT side of the
     gold contract, so it stays pale in *every* theme and *every* mode — which
     means its ink must stay DARK in every theme and every mode. Deliberately
     absent from both `.dark` blocks: a `dark:text-gray-300` on a surface that
     never darkens is invisible, which is the bug this token replaces.
     4.7:1 on the ramp's darkest stop (--gre #aa771c), 17:1 on --grb. */
  --ramp-ink: #16131b;
  --graa: #ffc857;
  --grbb: #3e2f5b;
  --neww: #49f3df;
  --wow: rgb(2, 255, 187);
  --wow2: rgb(144, 255, 17);
  --blueg: rgb(116, 191, 255);
  --oranges: rgb(254, 172, 49);
  --wowt: rgb(3, 55, 47);
}
/* The business palette used to live here. It has moved to the appearance
   layer at the end of this file — a plain `.business` block at this position
   is overruled by the `:root` further down (equal specificity, later wins),
   which is why it never took effect. Do not re-add tokens here. */
h1,
h2,
button {
  font-family: 'Sababa', 'Gan', 'Powerr';
}
h3 {
  font-family: 'Popins', 'Dorian';
}
h4,
h5,
h6 {
  font-family: 'Glad', 'Bellefair';
}
h7,
h8 {
  font-family: 'Dorian', 'Bellefair';
}
label,
input,
p,
div,
span {
  font-family: 'Bellefair', 'Gan';
}

.boxright {
  box-shadow:
    rgba(240, 46, 170, 0.4) 5px 5px,
    rgba(240, 46, 170, 0.3) 10px 10px,
    rgba(240, 46, 170, 0.2) 15px 15px,
    rgba(240, 46, 170, 0.1) 20px 20px,
    rgba(240, 46, 170, 0.05) 25px 25px;
}
.boxleft {
  box-shadow:
    rgba(240, 46, 170, 0.4) -5px 5px,
    rgba(240, 46, 170, 0.3) -10px 10px,
    rgba(240, 46, 170, 0.2) -15px 15px,
    rgba(240, 46, 170, 0.1) -20px 20px,
    rgba(240, 46, 170, 0.05) -25px 25px;
}
.tiptap ol li {
  counter-increment: muffins;
}
.tiptap ol li:before {
  content: counter(muffins) '. ';
  color: var(--gold);
}
.tiptap ol {
  list-style: none;
  counter-reset: muffins;
}
.tiptap ul {
  margin: 0;
  padding: 0 0 0 28px;
  list-style-image: url('https://res.cloudinary.com/love1/image/upload/v1701972931/list_agpi7e.svg');
  display: block;
}
.tiptap a {
  color: var(--lturk);
}
.tiptap h1 {
  font-size: 1.5rem;
}
.tiptap h3 {
  font-size: 1rem;
  font-family: 'Rubik', sans-serif;
  font-weight: 400;
}
.tiptap p {
  font-size: 0.8rem;
}
@media (min-width: 450px) {
  .tiptap h1 {
    font-size: 2rem;
  }
  .tiptap h3 {
    font-size: 1.5rem;
  }
  .tiptap p {
    font-size: 1.2rem;
  }
}
.tiptap p,
h1,
h2,
h3,
a,
li,
ul {
  background-color: inherit;
  color: inherit;
}
[data-color='pink'] > ::before {
  content: '❌ ⟵ : ';
  color: darkred;
  font-weight: bold;
}

[data-color='#a7f2a4'] > ::before {
  content: ' ✔ ⟵: ';
  color: darkgreen;
  font-weight: bold;
}

/* היילייט חיצוני */
[data-color='pink'] {
  border: 1px solid pink;
  padding: 5px;
  background-color: rgba(255, 182, 193, 0.2); /* ורוד חצי שקוף */
}

[data-color='#a7f2a4'] {
  border: 1px solid lightgreen;
  padding: 5px;
  background-color: #a7f2a4; /* ירוק חצי שקוף */
}
@media (min-width: 670px) {
  .tiptap h1 {
    font-size: 2.5rem;
  }
  .tiptap h3 {
    font-size: 2rem;
  }
  .tiptap p {
    font-size: 1.5rem;
  }
}
.tiptap blockquote {
  font-family: Sarabun;
  box-shadow: 7px 7px 13px lightgrey;
  background: var(--gold);
  margin-bottom: 18px;
  padding: 15px;
  font-size: 22px;
  border-left: solid var(--mturk);
  border-right: solid var(--mturk);
}

.tiptap blockquote:before {
  content: open-quote;
  font-size: 24pt;
  text-align: center;
  line-height: 42px;
  color: #fff;
  background: #ddd;
  float: left;
  position: relative;
  border-radius: 25px;
  margin-right: 0.5em;
  vertical-align: -0.4em;

  /** define it as a block element **/
  display: block;
  height: 25px;
  width: 25px;
}
.button-gold {
  color: rgba(0, 0, 0, 0.72);
  text-decoration: none;
  font-weight: bold;
  text-shadow: 1px 1px 0 #ffffff;
  box-shadow:
    2px 2px 0.5em rgba(122, 98, 0, 0.55),
    inset 1px 1px 0 rgba(255, 255, 255, 0.9),
    inset -1px -1px 0 rgba(0, 0, 0, 0.34);
  border: 1px solid #deca73;
  background: -moz-linear-gradient(
    -72deg,
    #ffde45,
    #ffffff 16%,
    #ffde45 21%,
    #ffffff 24%,
    #452100 27%,
    #ffde45 36%,
    #ffffff 45%,
    #ffffff 60%,
    #ffde45 72%,
    #ffffff 80%,
    #ffde45 84%,
    #452100
  );
  background: -webkit-linear-gradient(
    -72deg,
    #ffde45,
    #ffffff 16%,
    #ffde45 21%,
    #ffffff 24%,
    #452100 27%,
    #ffde45 36%,
    #ffffff 45%,
    #ffffff 60%,
    #ffde45 72%,
    #ffffff 80%,
    #ffde45 84%,
    #452100
  );
  background: -o-linear-gradient(
    -72deg,
    #ffde45,
    #ffffff 16%,
    #ffde45 21%,
    #ffffff 24%,
    #452100 27%,
    #ffde45 36%,
    #ffffff 45%,
    #ffffff 60%,
    #ffde45 72%,
    #ffffff 80%,
    #ffde45 84%,
    #452100
  );
  background: linear-gradient(
    -72deg,
    #ffde45,
    #ffffff 16%,
    #ffde45 21%,
    #ffffff 24%,
    #452100 27%,
    #ffde45 36%,
    #ffffff 45%,
    #ffffff 60%,
    #ffde45 72%,
    #ffffff 80%,
    #ffde45 84%,
    #452100
  );
}
.business .button-gold {
  color: rgba(30, 41, 59, 0.9);
  text-decoration: none;
  font-weight: 600;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
  box-shadow:
    0 2px 8px rgba(71, 85, 105, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    inset 0 -1px 0 rgba(71, 85, 105, 0.1);
  border: 1px solid #cbd5e1;
  background: linear-gradient(
    -72deg,
    #f8fafc,
    #ffffff 20%,
    #f1f5f9 35%,
    #ffffff 50%,
    #e2e8f0 65%,
    #ffffff 80%,
    #f8fafc
  );
  transition: all 0.2s ease;
}

.business .button-gold:hover {
  box-shadow:
    0 4px 12px rgba(71, 85, 105, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    inset 0 -1px 0 rgba(71, 85, 105, 0.15);
  transform: translateY(-1px);
}

.business .button-gold:active {
  box-shadow:
    0 1px 4px rgba(71, 85, 105, 0.2),
    inset 0 2px 4px rgba(71, 85, 105, 0.1);
  transform: translateY(0);
}
.button-silver {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
  font-weight: bold;
  text-shadow: 1px 1px 0 #ffffff;
  box-shadow:
    2px 2px 0.5em rgba(122, 122, 122, 0.55),
    inset 1px 1px 0 rgba(255, 255, 255, 0.9),
    inset -1px -1px 0 rgba(0, 0, 0, 0.34);
  border: 1px solid #dedede;
  background: -moz-linear-gradient(
    -72deg,
    #dedede,
    #ffffff 16%,
    #dedede 21%,
    #ffffff 24%,
    #a7a0a0 27%,
    #dedede 36%,
    #ffffff 45%,
    #ffffff 60%,
    #dedede 72%,
    #ffffff 80%,
    #dedede 84%,
    #a1a1a1
  );
  background: -webkit-linear-gradient(
    -72deg,
    #dedede,
    #ffffff 16%,
    #dedede 21%,
    #ffffff 24%,
    #a7a0a0 27%,
    #dedede 36%,
    #ffffff 45%,
    #ffffff 60%,
    #dedede 72%,
    #ffffff 80%,
    #dedede 84%,
    #a1a1a1
  );
  background: -o-linear-gradient(
    -72deg,
    #dedede,
    #ffffff 16%,
    #dedede 21%,
    #ffffff 24%,
    #454545 27%,
