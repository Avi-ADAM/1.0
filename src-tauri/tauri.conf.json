{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "1lev1",
  "version": "0.1.0",
  "identifier": "world.onelev1.app",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "1לב1",
        "url": "https://www.1lev1.com/?app=1",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
